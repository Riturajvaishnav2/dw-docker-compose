# ==============================================================================
# dw-docker-compose environment template
# Copy to .env and fill in values: cp .env.example .env
# ==============================================================================

# --- Postgres (backing DB for Airflow, Superset, OpenMetadata, Iceberg catalog) ---
POSTGRES_USER=platform
POSTGRES_PASSWORD=change_me
POSTGRES_DB=postgres
AIRFLOW_DB=airflow
SUPERSET_DB=superset

# --- MinIO (local S3-compatible object storage) ---
# Console UI: http://localhost:9001  |  S3 API: http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- S3 / object storage credentials used by iceberg-rest, spark, trino, airflow ---
# Generic OCI_* names are reused for whichever S3-compatible backend is active.
# For local dev, point these at the minio service above. To use real Oracle
# Cloud Object Storage instead, set USE_OCI_STORAGE=true and use OCI values.
OCI_ACCESS_KEY_ID=minioadmin
OCI_SECRET_ACCESS_KEY=minioadmin
OCI_REGION=us-east-1
OCI_S3_ENDPOINT=http://minio:9000
USE_OCI_STORAGE=false

# Buckets minio-init creates on startup
CATALOG_WAREHOUSE=warehouse
LANDING_BUCKET=landing

# --- Iceberg catalog / tenant namespace ---
ICEBERG_NAMESPACE=default
ICEBERG_ALEMBIC_APPLIED_BY=docker-compose

# --- Airflow ---
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=change_me
AIRFLOW_UID=50000

# --- Superset ---
SUPERSET_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_TRINO_DB_NAME=DataWarehouse
SUPERSET_TRINO_DB_URI=trino://admin:admin@trino:8443/iceberg?verify=false

# --- Trino ---
TRINO_USER=admin
TRINO_PASSWORD=

# --- Local service URLs (used to build base URLs / OAuth callbacks) ---
HTTP_SCHEME=http
AIRFLOW=localhost:8080
SUPERSET=localhost:8088
OPENMETADATA=localhost:8585

# --- SSO / Keycloak (required by trino, superset, airflow-webserver, openmetadata) ---
# A local Keycloak container is provided (docker-compose "keycloak" service);
# it auto-imports the realm/client from conf/keycloak/realm-export.json.
# Add "127.0.0.1 sso.local" to your host machine's /etc/hosts so the browser
# resolves the same hostname the containers reach via host-gateway.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me
KEYCLOAK_DB=keycloak
KEYCLOAK_PORT=8090
KEYCLOAK_REALM_URL=http://sso.local:8090/realms/dev-connected-platform
OAUTH_CLIENT_ID=organization-management
OAUTH_CLIENT_SECRET=change_me
OPENID_PROVIDER_URL=http://sso.local:8090/realms/dev-connected-platform/.well-known/openid-configuration
PRINCIPAL_DOMAIN=
SSO_HOST=sso.local
SSO_HOST_IP=127.0.0.1
PIPELINE_SERVICE_CLIENT_VERIFY_SSL=false

# --- To point at a remote Keycloak/SSO instead of the local one, set: ---
# KEYCLOAK_REALM_URL=https://<your-sso-host>/auth/realms/<realm>
# OAUTH_CLIENT_ID=<client-id>
# OAUTH_CLIENT_SECRET=<client-secret>
# OPENID_PROVIDER_URL=<discovery-url>

# --- Optional external integrations (openmetadata-ingestion / trino connectors) ---
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
PINOT_BROKER_HOST=
PINOT_BROKER_PORT=8099
PINOT_CONTROLLER_HOST=
PINOT_CONTROLLER_PORT=9000
OM_INGESTION_JWT=

# --- ngrok (only used with `docker compose --profile ngrok up`) ---
NGROK_AUTHTOKEN=
